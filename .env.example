# ============================================================================
# MyTV Environment Template (.env.example)
# Copy to .env and fill in your own free values. Never commit .env!
# ============================================================================

# --- Primary TV Target ---
TV_MODEL=
TV_IP=
TV_ADB_PORT=5555
TV_MAC=
TV_ANDROID_BUILD=
TV_KERNEL=

# --- Region & Localization ---
REGION=US
CURRENCY=USD
TEMPERATURE_UNIT=auto
TIMEZONE=
LATITUDE=
LONGITUDE=
CITY=

# --- Cloud Database & Auth (Supabase Free Tier - PostgreSQL + Auth + Realtime) ---
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
HOUSEHOLD_KEY=
ADMIN_EMAILS=

# --- Media Discovery, Ratings & AI Search ---
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
OMDB_API_KEY=
MDBLIST_API_KEY=
GEMINI_API_KEY=

# --- Trakt.tv ---
TRAKT_USERNAME=
TRAKT_EMAIL=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# --- Stremio / AIOStreams / Debrid Providers ---
AIOSTREAMS_UUID=
AIOSTREAMS_MANIFEST_URL=
CINEMETA_URL=https://v3-cinemeta.strem.io
REAL_DEBRID_API_TOKEN=
TORBOX_API_KEY=

# --- Optional Self-Hosted GitHub OTA Updates ---
GITHUB_REPO=
GITHUB_TOKEN=

# --- Optional Feature Tabs ('auto', 'true', or 'false') ---
ENABLE_GAMING=auto
ENABLE_SMARTHOME=auto

# --- Optional Windows PC Gaming Streaming (Phase B) ---
GAMING_PC_IP=
GAMING_PC_MAC=
GAMING_PC_TOKEN=
# Semicolon-separated list of standalone game folders on your Windows PC (e.g. C:\Games;E:\PCGames)
MYTV_GAMES_DIRS=
# Comma-separated EDID or friendly-name substrings of non-TV desk monitors to exclude from HDMI auto-detection
# Run: python MyTV-launcher/tools/gaming/laptop_gaming_agent.py --list-monitors
MYTV_NON_TV_MONITORS=

# --- Smart Home Integrations ---
SENSIBO_API_KEY=
WIZ_LIGHT_IPS=
SWITCHER_DEVICE_IP=
SWITCHER_DEVICE_ID=
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_DEVICE_IP=
